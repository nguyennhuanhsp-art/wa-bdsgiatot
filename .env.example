# Local development only. Replace values; never commit .env.
# Quote URLs if the chosen password contains special URL characters; URL-encode passwords in URLs.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DATABASE_ADMIN_URL=postgresql://bds_owner:REPLACE_WITH_LONG_RANDOM_PASSWORD@127.0.0.1:5432/bdsgiatot
DATABASE_API_URL=postgresql://bds_app_login:REPLACE_API_PASSWORD@127.0.0.1:5432/bdsgiatot
DATABASE_AUTH_URL=postgresql://bds_auth_login:REPLACE_AUTH_PASSWORD@127.0.0.1:5432/bdsgiatot
DATABASE_WORKER_URL=postgresql://bds_worker_login:REPLACE_WORKER_PASSWORD@127.0.0.1:5432/bdsgiatot
# Set these only for provisioning; remove from app deployments afterwards.
API_DB_PASSWORD=REPLACE_API_PASSWORD
AUTH_DB_PASSWORD=REPLACE_AUTH_PASSWORD
WORKER_DB_PASSWORD=REPLACE_WORKER_PASSWORD
# Set email/name only; bootstrap script prompts for password without displaying it.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
WEB_ORIGIN=http://localhost:3000
API_PORT=3001
# Configure private bucket, public image bucket, mail provider and cookie secrets before HTTP launch.
